# Reliquary optional AI
# 1. Copy this file and name the copy ".env" (same folder as start.sh)
# 2. Paste your key after the equals sign — no quotes, no spaces
# 3. Stop Reliquary (Ctrl+C) and run ./start.sh again
#
# .env is gitignored. Never commit a real key.

# xAI Grok — create a key at https://console.x.ai (API keys)
XAI_API_KEY=

